<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone dev tool, NOT part of the plugin build: self-check for DeathCounter, the one
       piece of plugin logic with no Unity/game-API dependency. See tools/README.md to run it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>DeathCounterCheck</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/plugin/DeathCounter.cs" />
  </ItemGroup>
</Project>
